
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  refreshToken String? @unique

  filespacesMember FileSpaceMember[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FileSpace {
  id Int @id @default(autoincrement())
  name String
  
  members FileSpaceMember[]
  files File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model File {
  id Int @id @default(autoincrement())
  name String

  originalName String
  storedName String
  path String
  mimeType String
  size BigInt

  fileSpaceId Int
  fileSpace FileSpace @relation(fields: [fileSpaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileSpaceId])
}

model FileSpaceMember {
  id Int @id @default(autoincrement())
  role role @default(MEMBER)

  fileSpaceId Int
  fileSpace FileSpace @relation(fields: [fileSpaceId], references: [id], onDelete: Cascade)

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileSpaceId])
  @@index([userId])
}

enum role {
  OWNER
  MEMBER
  VIEWER
}